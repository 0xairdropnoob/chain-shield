{
  "name": "chain-sentinel",
  "version": "1.0.0",
  "description": "Official JavaScript/TypeScript SDK for Chain Sentinel — Token safety scanner across 9 blockchains",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "blockchain",
    "crypto",
    "security",
    "scanner",
    "rugpull",
    "honeypot",
    "token",
    "defi",
    "web3",
    "sentinel"
  ],
  "author": "ChainShield",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ChainShieldSn/chain-shield.git",
    "directory": "sdk/javascript"
  },
  "homepage": "https://chainshieldsentinel.tech",
  "bugs": {
    "url": "https://github.com/ChainShieldSn/chain-shield/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
